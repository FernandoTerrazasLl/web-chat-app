<div class="settings-btn">
	<button class="settings-btn__trigger" type="button" aria-label="Opciones">
		<img src="{{optionsIconSrc}}" alt="Opciones" class="settings-btn__icon">
	</button>

	<div class="settings-btn__menu {{menuClass}}">
		<button type="button" class="settings-btn__menu-item" data-option="add">
			<img src="{{addIconSrc}}" alt="Agregar" class="settings-btn__menu-icon">
			Agregar usuario
		</button>

		<button type="button" class="settings-btn__menu-item" data-option="delete">
			<img src="{{deleteIconSrc}}" alt="Eliminar" class="settings-btn__menu-icon">
			Eliminar usuario
		</button>
	</div>
</div>
