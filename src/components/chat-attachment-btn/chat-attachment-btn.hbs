<div class="chat-attachment-btn">
	<button type="button" class="chat-attachment-btn__trigger" aria-label="Adjuntar">
		<img src="{{clipIconSrc}}" alt="Adjuntar" class="chat-attachment-btn__trigger-icon">
	</button>

	<div class="chat-attachment-btn__menu {{menuClass}}">
		<button type="button" class="chat-attachment-btn__option" data-option="media">
			<img src="{{fotoIconSrc}}" alt="Foto o Video" class="chat-attachment-btn__option-icon">
			Foto o Video
		</button>

		<button type="button" class="chat-attachment-btn__option" data-option="file">
			<img src="{{fileIconSrc}}" alt="File" class="chat-attachment-btn__option-icon">
			File
		</button>

		<button type="button" class="chat-attachment-btn__option" data-option="location">
			<img src="{{ubicationIconSrc}}" alt="Ubicacion" class="chat-attachment-btn__option-icon">
			Ubicacion
		</button>
	</div>
</div>
